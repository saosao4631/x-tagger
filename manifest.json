{
  "manifest_version": 3,
  "name": "X Tagger",
  "version": "0.1.0",
  "description": "x.com のツイートにキーワードタグを表示し、広告を非表示にし、頻出単語を自動でタグ化する拡張機能",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["statistics.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Tagger 設定"
  }
}
